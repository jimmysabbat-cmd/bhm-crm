// Prisma schema - BHM CRM
// Montants monétaires stockés en centimes (Int) - jamais de float sur de l'argent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  COMMERCIAL
  COMPTA
}

enum Precarite {
  TRES_MODESTE
  MODESTE
  INTERMEDIAIRE
  SUPERIEUR
}

enum ZoneClimatique {
  H1
  H2
  H3
}

enum TypeTravaux {
  // Chauffage et eau chaude sanitaire
  RACCORDEMENT_RESEAU_CHALEUR
  CHAUFFE_EAU_THERMODYNAMIQUE
  PAC_AIR_EAU
  PAC_AIR_AIR
  PAC_GEOTHERMIQUE_SOLAROTHERMIQUE
  CHAUFFE_EAU_SOLAIRE_INDIVIDUEL
  CHAUFFAGE_SOLAIRE_COMBINE
  PVT_EAU
  POELE_BUCHES
  POELE_GRANULES
  CHAUDIERE_BOIS_MANUELLE
  CHAUDIERE_BOIS_AUTOMATIQUE
  FOYER_FERME_INSERT
  // Isolation thermique
  ITE
  ITI
  COMBLES
  RAMPANTS
  TOITURE_TERRASSE
  PAROIS_VITREES
  // Autres travaux
  AUDIT_ENERGETIQUE
  DEPOSE_CUVE_FIOUL
  VMC
  // Historique / autres
  BALLON_THERMODYNAMIQUE
  AUTRE
}

enum TypeTache {
  RELANCE_CLIENT
  RELANCE_CEE
  RELANCE_ANAH
  RELANCE_FOURNISSEUR
  RELANCE_SOUS_TRAITANT
  AUTRE
}

enum StatutTache {
  A_FAIRE
  FAIT
  ANNULE
}

enum StatutCommande {
  COMMANDEE
  LIVREE
  RETIREE
  ANNULEE
}

enum TypeDocument {
  DEVIS
  AUDIT
  PHOTO_VISITE
  PHOTO_CHANTIER
  AUTRE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMMERCIAL)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tachesAssignees Tache[]
  dossiersCrees   Dossier[]
}

// Listes paramétrables depuis /parametrage - remplacent d'anciens enums figés
// pour permettre à l'admin d'ajouter/renommer/désactiver sans déploiement.
model DossierType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model DossierStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model ModePaiement {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Accompagnateurs Rénov (MAR) - gérés depuis /parametrage, choisis sur les
// dossiers de rénovation d'ampleur.
model Mar {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Équipes internes ("régie") - alternative à la sous-traitance pour la pose
// d'un poste de travaux, gérées depuis /parametrage.
model Regie {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  postesTravaux DossierPosteTravaux[]
}

// Délégataires CEE - gérés depuis /parametrage, chaque dossier avec de la
// prime CEE en a un (obligatoire pour percevoir la prime).
model DelegataireCee {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Taux de rachat CEE (€ par MCumac, en centimes) proposés par ce
  // délégataire, et délai de paiement après dépôt du dossier chez lui.
  rachatTresModesteCts Int?
  rachatClassiqueCts   Int?
  delaiPaiementJours   Int?

  dossiers Dossier[]
}

// Statuts du suivi administratif ANAH (spécifique rénovation d'ampleur),
// distincts du statut général du dossier.
model StatutAnah {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model Client {
  id             String          @id @default(cuid())
  prenom         String
  nom            String
  email          String?
  telephone      String?
  adresse        String?
  codePostal     String?
  ville          String?
  precarite      Precarite?
  zoneClimatique ZoneClimatique?

  // Infos techniques du logement
  surfaceHabitableM2 Int?
  anneeConstruction  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossiers Dossier[]
}

model Dossier {
  id        String @id @default(cuid())
  reference String @unique
  clientId  String
  client    Client @relation(fields: [clientId], references: [id])

  typeId String
  type   DossierType @relation(fields: [typeId], references: [id])

  statutId String
  statut   DossierStatus @relation(fields: [statutId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Montants en centimes
  montantDevisTTC Int
  montantAideMPR  Int @default(0)
  montantAideCEE  Int @default(0)

  montantEncaisseClient Int @default(0)
  montantEncaisseMPR    Int @default(0)
  montantEncaisseCEE    Int @default(0)

  modePaiementAideId String?
  modePaiementAide   ModePaiement? @relation(fields: [modePaiementAideId], references: [id])
  marId              String?
  mar                Mar? @relation(fields: [marId], references: [id])
  delegataireCeeId   String?
  delegataireCee     DelegataireCee? @relation(fields: [delegataireCeeId], references: [id])
  dateDepotDelegataireCee DateTime?

  // Suivi administratif ANAH (rénovation d'ampleur uniquement)
  statutAnahId   String?
  statutAnah     StatutAnah? @relation(fields: [statutAnahId], references: [id])
  dateDepotAnah  DateTime?
  dateOctroiAnah DateTime?

  dateSignatureDevis DateTime?
  dateDebutTravaux   DateTime?
  dateFinTravaux     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postesTravaux DossierPosteTravaux[]
  documents     DossierDocument[]
  taches        Tache[]
  commandes     Commande[]

  @@index([statutId])
  @@index([typeId])
  @@index([clientId])
}

model DossierPosteTravaux {
  id                     String      @id @default(cuid())
  dossierId              String
  dossier                Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type                   TypeTravaux
  surfaceM2              Float?
  quantite               Int? // ex. nombre de splits pour une PAC air/air, nombre de fenêtres...
  montantCumac           Int? // en kWh cumac
  montantPrimeCalculeCts Int? // prime CEE calculée, en centimes

  // Qui pose ce poste : sous-traitant OU régie (équipe interne), pas les deux
  sousTraitantId              String?
  sousTraitant                SousTraitant? @relation(fields: [sousTraitantId], references: [id])
  montantPoseSousTraitanceCts Int? // montant confié au sous-traitant, en centimes

  regieId         String?
  regie           Regie? @relation(fields: [regieId], references: [id])
  montantRegieCts Int? // montant de la pose en régie, en centimes

  montantMaterielHTCts  Int? // en centimes
  montantMaterielTTCCts Int? // en centimes

  createdAt DateTime @default(now())

  @@index([dossierId])
}

model SousTraitant {
  id                 String       @id @default(cuid())
  nom                String
  typeTravaux        TypeTravaux?
  tarifM2Cts         Int? // tarif au m2, en centimes
  tarifFixeCts       Int? // tarif fixe, en centimes
  fourniPose         Boolean      @default(false)
  telephone          String?
  email              String?
  delaiPaiementJours Int? // délai de paiement après fin de travaux
  actif              Boolean      @default(true)
  createdAt          DateTime     @default(now())

  commandes     Commande[]
  postesTravaux DossierPosteTravaux[]
}

// Documents et photos attachés à un dossier (devis, audit, photos de visite
// ou de chantier). Fichiers stockés sur disque, servis via une route API
// protégée par authentification.
model DossierDocument {
  id            String       @id @default(cuid())
  dossierId     String
  dossier       Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type          TypeDocument
  nomFichier    String
  cheminFichier String
  mimeType      String
  tailleOctets  Int
  createdAt     DateTime     @default(now())

  @@index([dossierId])
}

model Fournisseur {
  id                 String   @id @default(cuid())
  nom                String
  delaiPaiementJours Int?
  telephone          String?
  email              String?
  createdAt          DateTime @default(now())

  commandes Commande[]
}

model Commande {
  id             String        @id @default(cuid())
  dossierId      String
  dossier        Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fournisseurId  String?
  fournisseur    Fournisseur?  @relation(fields: [fournisseurId], references: [id])
  sousTraitantId String?
  sousTraitant   SousTraitant? @relation(fields: [sousTraitantId], references: [id])

  numeroBL            String?
  montantCts          Int // en centimes
  statut              StatutCommande @default(COMMANDEE)
  dateCommande        DateTime       @default(now())
  dateLivraisonPrevue DateTime?
  dateLivraisonReelle DateTime?

  createdAt DateTime @default(now())

  @@index([dossierId])
  @@index([fournisseurId])
}

model Tache {
  id           String      @id @default(cuid())
  dossierId    String
  dossier      Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type         TypeTache
  titre        String
  description  String?
  dateEcheance DateTime
  statut       StatutTache @default(A_FAIRE)
  assigneAId   String?
  assigneA     User?       @relation(fields: [assigneAId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossierId])
  @@index([statut, dateEcheance])
}
