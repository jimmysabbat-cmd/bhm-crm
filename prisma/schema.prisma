// Prisma schema - BHM CRM
// Montants monétaires stockés en centimes (Int) - jamais de float sur de l'argent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Rôles existants (ADMIN, COMMERCIAL, COMPTA) conservés tels quels pour ne
// rien casser sur les comptes déjà créés. Nouveaux rôles ajoutés en vue du
// futur requireRole()/hasPermission() (non implémenté dans cette étape) :
// COMPTABILITE est le nom canonique désormais pour ce rôle - COMPTA reste
// valide uniquement pour compatibilité avec des comptes existants.
enum Role {
  ADMIN
  COMMERCIAL
  COMPTA
  ADMINISTRATIF
  REGIE
  SOUS_TRAITANT
  COMPTABILITE
  TECHNIQUE
  // P9 - téléprospection : appelle les leads assignés/à appeler, remplit le
  // questionnaire, journalise les interactions. Pas d'accès financier/
  // réglementaire (mêmes exclusions que COMMERCIAL sur VIEW_MARGIN etc.)
  TELEPROSPECTEUR
}

enum Precarite {
  TRES_MODESTE
  MODESTE
  INTERMEDIAIRE
  SUPERIEUR
}

enum ZoneClimatique {
  H1
  H2
  H3
}

enum TypeTravaux {
  // Chauffage et eau chaude sanitaire
  RACCORDEMENT_RESEAU_CHALEUR
  CHAUFFE_EAU_THERMODYNAMIQUE
  PAC_AIR_EAU
  PAC_AIR_AIR
  PAC_GEOTHERMIQUE_SOLAROTHERMIQUE
  CHAUFFE_EAU_SOLAIRE_INDIVIDUEL
  CHAUFFAGE_SOLAIRE_COMBINE
  PVT_EAU
  POELE_BUCHES
  POELE_GRANULES
  CHAUDIERE_BOIS_MANUELLE
  CHAUDIERE_BOIS_AUTOMATIQUE
  FOYER_FERME_INSERT
  // Isolation thermique
  ITE
  ITI
  COMBLES
  RAMPANTS
  TOITURE_TERRASSE
  PAROIS_VITREES
  // Autres travaux
  AUDIT_ENERGETIQUE
  DEPOSE_CUVE_FIOUL
  VMC
  // Historique / autres
  BALLON_THERMODYNAMIQUE
  AUTRE
}

enum TypeTache {
  RELANCE_CLIENT
  RELANCE_CEE
  RELANCE_ANAH
  RELANCE_FOURNISSEUR
  RELANCE_SOUS_TRAITANT
  AUTRE
}

enum StatutTache {
  A_FAIRE
  FAIT
  ANNULE
}

enum StatutCommande {
  COMMANDEE
  LIVREE
  RETIREE
  ANNULEE
}

enum TypeDocument {
  DEVIS
  AUDIT
  PHOTO_VISITE
  PHOTO_CHANTIER
  AUTRE
}

enum TypeMouvementFinancier {
  ENTREE
  SORTIE
}

// P6 : valeurs ajoutées de façon purement additive (jamais de renommage ni
// suppression) pour ne casser aucune donnée existante. ENCAISSEMENT_CLIENT/
// ANAH/MPR/CEE, PAIEMENT_SOUS_TRAITANT/FOURNISSEUR et COMMISSION_* restent
// les catégories historiques ; les nouvelles couvrent les flux génériques
// demandés par le moteur financier (financement partenaire, avances,
// prestataires divers) qui n'avaient pas encore de catégorie dédiée.
enum CategorieMouvementFinancier {
  ENCAISSEMENT_CLIENT
  ENCAISSEMENT_ANAH
  ENCAISSEMENT_MPR
  ENCAISSEMENT_CEE
  PAIEMENT_SOUS_TRAITANT
  PAIEMENT_FOURNISSEUR
  COMMISSION_COMMERCIALE
  COMMISSION_REGIE
  COMMISSION_APPORTEUR
  AUTRE_ENTREE
  AUTRE_SORTIE
  // --- Entrées supplémentaires (P6) ---
  CLIENT_ACOMPTE
  CLIENT_SOLDE
  // Remboursement par le client d'une avance faite par l'entreprise (ex :
  // l'ANAH verse l'aide directement au client alors que l'entreprise avait
  // déjà déduit ce montant de la facture) - jamais du CA, cf. financial-engine.ts.
  REMBOURSEMENT_AVANCE_CLIENT
  FINANCEMENT_PARTENAIRE
  // --- Sorties supplémentaires (P6) ---
  POSE_INTERNE
  PAIEMENT_MAR
  PAIEMENT_AUDIT
  PAIEMENT_CONTROLE
  TRANSPORT
  LOCATION_MATERIEL
  ECHAFAUDAGE
  FRAIS_FINANCEMENT
}

enum StatutMouvementFinancier {
  PREVU
  A_RECEVOIR
  A_PAYER
  PARTIEL
  RECU
  PAYE
  ANNULE
  EN_RETARD
  LITIGE
  BLOQUE
}

// Qui paie / qui reçoit, en complément du libellé libre payeur/beneficiaire
// (nom) déjà existant sur MouvementFinancier - permet de filtrer/agréger
// par type de partie prenante sans dépendre d'un texte libre.
enum PartiePrenante {
  CLIENT
  ENTREPRISE
  ANAH
  CEE
  FINANCEUR
  FOURNISSEUR
  SOUS_TRAITANT
  REGIE
  COMMERCIAL
  APPORTEUR
  MAR
  AUTRE
}

// Condition d'exigibilité d'un mouvement (utile surtout pour les
// commissions/dettes) - champ préparé pour la V1, pas encore de moteur
// événementiel qui déclenche automatiquement le passage à A_PAYER/A_RECEVOIR.
enum ConditionExigibilite {
  A_LA_SIGNATURE
  A_L_ACCEPTATION
  AU_DEMARRAGE_TRAVAUX
  A_LA_FIN_TRAVAUX
  A_L_ENCAISSEMENT_CLIENT
  A_L_ENCAISSEMENT_ANAH
  A_L_ENCAISSEMENT_CEE
  MANUEL
}

// Flux métier auquel une étape de programme se rattache (vue synthétique,
// indépendant des colonnes statut*Id existantes sur Dossier).
enum TypeFluxEtape {
  COMMERCIAL
  ADMINISTRATIF
  ANAH
  CEE
  TRAVAUX
  FINANCIER
  AUTRE
}

enum StatutDossierEtape {
  NON_DISPONIBLE
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  BLOQUE
  TERMINE
  IGNORE
  ANNULE
}

// Une seule règle de dépendance pour cette V1 : l'étape ne devient
// disponible que lorsque TOUTES ses dépendances sont TERMINE. L'enum
// existe pour permettre d'ajouter des règles plus tard sans migration
// structurelle (ANY_COMPLETED, etc.).
enum TypeDependanceEtape {
  ALL_COMPLETED
}

// Une entreprise/organisation cliente de la plateforme. Une seule
// organisation active aujourd'hui (BHM), mais toutes les entités
// structurantes (User, Client, Dossier) y sont déjà rattachées pour
// permettre un cloisonnement multi-entreprise ultérieur sans nouvelle
// migration lourde.
model Organisation {
  id        String   @id @default(cuid())
  nom       String
  slug      String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  clients              Client[]
  dossiers             Dossier[]
  mouvementsFinanciers MouvementFinancier[]
  auditLogs            AuditLog[]
  programmes           Programme[]
  dossierEtapes        DossierEtape[]
  reglesRelance        RegleRelance[]
  calculsReglementaires CalculReglementaire[]
  tarifsDelegataireCee  TarifDelegataireCee[]
  etudesDossier         EtudeDossier[]

  // P9
  leads                  Lead[]
  logements              Logement[]
  champsProvenance       ChampProvenance[]
  questionnaires         Questionnaire[]
  reponsesQuestionnaire  ReponseQuestionnaire[]
  interactionsCommerciales InteractionCommerciale[]
  rdvs                   Rdv[]

  // P10
  dossierDocuments        DossierDocument[]
  typeDocumentReferentiels TypeDocumentReferentiel[]
  documentRequirements    DocumentRequirement[]
  transmissionPackages    TransmissionPackage[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMMERCIAL)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  tachesAssignees        Tache[]
  dossiersCrees          Dossier[]
  mouvementsCrees        MouvementFinancier[]
  auditLogs              AuditLog[]
  dossierEtapesAssignees DossierEtape[]
  calculsReglementairesCrees    CalculReglementaire[] @relation("CalculReglementaireCreatedBy")
  calculsReglementairesOverrides CalculReglementaire[] @relation("CalculReglementaireOverrideBy")
  etudesDossierCrees            EtudeDossier[]
  etudesDossierSelectionnees    EtudeDossier[] @relation("EtudeDossierSelectedBy")

  // P9
  leadsCommercial        Lead[] @relation("LeadCommercial")
  leadsTeleprospecteur   Lead[] @relation("LeadTeleprospecteur")
  leadsClaimedBy         Lead[] @relation("LeadClaimedBy")
  leadsCreated           Lead[] @relation("LeadCreatedBy")
  champsProvenanceAcceptees ChampProvenance[] @relation("ChampProvenanceAcceptedBy")
  interactionsCommerciales InteractionCommerciale[]
  rdvsCommercial         Rdv[] @relation("RdvCommercial")
  rdvsCrees              Rdv[] @relation("RdvCreatedBy")
  leadStatusChanges      LeadStatusHistory[]

  // P10
  dossierDocumentsValidees DossierDocument[] @relation("DossierDocumentValidatedBy")
  dossierDocumentsCreees   DossierDocument[] @relation("DossierDocumentCreatedBy")
  transmissionPackagesTransmis TransmissionPackage[] @relation("TransmissionPackageTransmittedBy")
  transmissionPackagesCrees    TransmissionPackage[] @relation("TransmissionPackageCreatedBy")

  @@index([organisationId])
}

// Listes paramétrables depuis /parametrage - remplacent d'anciens enums figés
// pour permettre à l'admin d'ajouter/renommer/désactiver sans déploiement.
model DossierType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model DossierStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model ModePaiement {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Accompagnateurs Rénov (MAR) - gérés depuis /parametrage, choisis sur les
// dossiers de rénovation d'ampleur.
model Mar {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Équipes internes ("régie") - alternative à la sous-traitance pour la pose
// d'un poste de travaux, gérées depuis /parametrage.
model Regie {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  postesTravaux DossierPosteTravaux[]
}

// Délégataires CEE - gérés depuis /parametrage, chaque dossier avec de la
// prime CEE en a un (obligatoire pour percevoir la prime).
model DelegataireCee {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Taux de rachat CEE (€ par MCumac, en centimes) proposés par ce
  // délégataire, et délai de paiement après dépôt du dossier chez lui.
  rachatTresModesteCts Int?
  rachatClassiqueCts   Int?
  delaiPaiementJours   Int?

  dossiers Dossier[]
  tarifs   TarifDelegataireCee[]
}

// Statuts du suivi administratif ANAH (spécifique rénovation d'ampleur),
// distincts du statut général du dossier.
model StatutAnah {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Statut du flux CEE, indépendant du statut général et du statut ANAH -
// même pattern paramétrable que StatutAnah (géré depuis /parametrage).
model StatutCee {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Statut du flux travaux/chantier, indépendant des autres flux - même
// pattern paramétrable que StatutAnah.
model StatutTravaux {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model Client {
  id             String          @id @default(cuid())
  prenom         String
  nom            String
  email          String?
  telephone      String?
  adresse        String?
  codePostal     String?
  ville          String?
  precarite      Precarite?
  zoneClimatique ZoneClimatique?

  // Infos techniques du logement
  surfaceHabitableM2 Int?
  anneeConstruction  Int?

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossiers Dossier[]

  // P9
  leads    Lead[]
  logement Logement?

  // P10
  dossierDocuments DossierDocument[]

  @@index([organisationId])
}

model Dossier {
  id        String @id @default(cuid())
  reference String @unique
  clientId  String
  client    Client @relation(fields: [clientId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  typeId String
  type   DossierType @relation(fields: [typeId], references: [id])

  // Statut général du dossier - vue synthétique/legacy conservée pour la V1.
  // Les vrais sous-processus vivent progressivement dans leurs propres flux
  // (statutAnahId, statutCeeId, statutTravauxId ci-dessous, puis un futur
  // flux commercial paramétrable avec le moteur de programmes).
  statutId String
  statut   DossierStatus @relation(fields: [statutId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Montants en centimes
  montantDevisTTC Int
  montantAideMPR  Int @default(0)
  montantAideCEE  Int @default(0)

  montantEncaisseClient Int @default(0)
  montantEncaisseMPR    Int @default(0)
  montantEncaisseCEE    Int @default(0)

  modePaiementAideId String?
  modePaiementAide   ModePaiement? @relation(fields: [modePaiementAideId], references: [id])
  marId              String?
  mar                Mar? @relation(fields: [marId], references: [id])
  delegataireCeeId   String?
  delegataireCee     DelegataireCee? @relation(fields: [delegataireCeeId], references: [id])
  dateDepotDelegataireCee DateTime?

  // Suivi administratif ANAH (rénovation d'ampleur uniquement)
  statutAnahId   String?
  statutAnah     StatutAnah? @relation(fields: [statutAnahId], references: [id])
  dateDepotAnah  DateTime?
  dateOctroiAnah DateTime?

  // Flux CEE et flux travaux/chantier - indépendants du statut général et
  // du suivi ANAH, sur le même principe (optionnels, paramétrables).
  statutCeeId      String?
  statutCee        StatutCee? @relation(fields: [statutCeeId], references: [id])
  statutTravauxId  String?
  statutTravaux    StatutTravaux? @relation(fields: [statutTravauxId], references: [id])

  // Programme/workflow paramétrable (optionnel - un dossier créé avant ou
  // sans programme n'en a pas). La version est figée à l'affectation : si
  // le programme évolue ensuite, ce dossier garde SA version et son
  // comportement ne change jamais rétroactivement.
  programmeVersionId String?
  programmeVersion   ProgrammeVersion? @relation(fields: [programmeVersionId], references: [id])

  dateSignatureDevis DateTime?
  dateDebutTravaux   DateTime?
  dateFinTravaux     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postesTravaux        DossierPosteTravaux[]
  documents            DossierDocument[]
  taches               Tache[]
  commandes            Commande[]
  mouvementsFinanciers MouvementFinancier[]
  dossierEtapes        DossierEtape[]
  calculsReglementaires CalculReglementaire[]
  etudesDossier        EtudeDossier[]

  // P9
  lead     Lead?
  logement Logement?
  rdvs     Rdv[]

  // P10
  transmissionPackages TransmissionPackage[]

  @@index([statutId])
  @@index([typeId])
  @@index([clientId])
  @@index([organisationId])
  @@index([statutCeeId])
  @@index([statutTravauxId])
  @@index([programmeVersionId])
}

model DossierPosteTravaux {
  id                     String      @id @default(cuid())
  dossierId              String
  dossier                Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type                   TypeTravaux
  surfaceM2              Float?
  quantite               Int? // ex. nombre de splits pour une PAC air/air, nombre de fenêtres...
  montantDevisHTCts      Int? // montant HT de ce geste sur le devis (base éligible aux aides)
  montantDevisTTCCts     Int?
  montantCumac           Int? // en kWh cumac
  montantPrimeCalculeCts Int? // prime CEE calculée, en centimes

  // Qui pose ce poste : sous-traitant OU régie (équipe interne), pas les deux
  sousTraitantId              String?
  sousTraitant                SousTraitant? @relation(fields: [sousTraitantId], references: [id])
  montantPoseSousTraitanceCts Int? // montant confié au sous-traitant, en centimes

  regieId         String?
  regie           Regie? @relation(fields: [regieId], references: [id])
  montantRegieCts Int? // montant de la pose en régie, en centimes

  montantMaterielHTCts  Int? // en centimes
  montantMaterielTTCCts Int? // en centimes

  // Rattachement réglementaire (P7) - purement additif, les champs legacy
  // montantCumac/montantPrimeCalculeCts ci-dessus restent la source utilisée
  // par l'UI existante et ne sont jamais supprimés (section 12/33 du prompt
  // P7). ficheReglementaireCode identifie la fiche CEE visée (ex.
  // "BAR-TH-171") sans imposer qu'un calcul existe déjà. calculReglementaireActifId
  // pointe vers LE CalculReglementaire retenu comme référence courante pour
  // ce poste (peut être un calcul OFFICIEL ou une simulation retenue) -
  // jamais écrasé silencieusement, cf. CalculReglementaire.
  ficheReglementaireCode     String?
  calculReglementaireActifId String?              @unique
  calculReglementaireActif   CalculReglementaire? @relation("PosteCalculActif", fields: [calculReglementaireActifId], references: [id])

  calculsReglementaires CalculReglementaire[] @relation("PosteCalculsHistorique")

  // P10
  dossierDocuments DossierDocument[]

  createdAt DateTime @default(now())

  @@index([dossierId])
}

model SousTraitant {
  id                 String       @id @default(cuid())
  nom                String
  typeTravaux        TypeTravaux?
  tarifM2Cts         Int? // tarif au m2, en centimes
  tarifFixeCts       Int? // tarif fixe, en centimes
  fourniPose         Boolean      @default(false)
  telephone          String?
  email              String?
  delaiPaiementJours Int? // délai de paiement après fin de travaux
  actif              Boolean      @default(true)
  createdAt          DateTime     @default(now())

  commandes     Commande[]
  postesTravaux DossierPosteTravaux[]
}

// Documents et photos attachés à un dossier (devis, audit, photos de visite
// ou de chantier). Fichiers stockés sur disque, servis via une route API
// protégée par authentification.
model DossierDocument {
  id            String       @id @default(cuid())
  dossierId     String
  dossier       Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  // Ancien enum figé, JAMAIS modifié (préserve les documents existants tels
  // quels) - le nouveau moteur documentaire (P10) utilise exclusivement
  // typeDocumentId ci-dessous. Un mapping best-effort renseigne encore ce
  // champ pour les nouveaux documents afin que documentsRequisStatus() (P5/
  // workflow existant) continue de fonctionner sans modification.
  type          TypeDocument
  nomFichier    String
  cheminFichier String
  mimeType      String
  tailleOctets  Int
  createdAt     DateTime     @default(now())

  // ============================================================
  // P10 - moteur documentaire
  // ============================================================
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  typeDocumentId String?
  typeDocumentRef TypeDocumentReferentiel? @relation(fields: [typeDocumentId], references: [id])
  requirementId  String?
  requirement    DocumentRequirement? @relation(fields: [requirementId], references: [id])

  // Portée (section 9) - à qui/quoi se rattache précisément cette pièce
  // (au-delà du dossier lui-même).
  portee         PorteeDocument @default(DOSSIER)
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id])
  posteTravauxId String?
  posteTravaux   DossierPosteTravaux? @relation(fields: [posteTravauxId], references: [id])

  statut         StatutDocument @default(FOURNI)
  dateExpiration DateTime?

  // Validation (section 5) - audit obligatoire.
  validatedById     String?
  validatedBy       User?     @relation("DossierDocumentValidatedBy", fields: [validatedById], references: [id])
  validatedAt       DateTime?
  validationComment String?
  rejectionReason   String?

  // Version/remplacement (section 6) - ne supprime jamais silencieusement
  // l'ancien : replacesId pointe vers le document que CE document remplace,
  // et l'ancien devient consultable via replacedBy + passe au statut
  // REMPLACE (jamais supprimé).
  // Pas de @unique DB ici (éviterait un push --accept-data-loss non
  // consenti sur cette colonne nouvellement ajoutée) - l'invariant "au plus
  // un document en remplace un autre" est garanti au niveau applicatif
  // (Server Action de remplacement), jamais par contrainte DB.
  replacesId String?
  replaces   DossierDocument?  @relation("DocumentReplacement", fields: [replacesId], references: [id])
  replacedBy DossierDocument[] @relation("DocumentReplacement")
  version    Int               @default(1)

  // Provenance (réutilise l'enum SourceDonnee du moteur logement P9 - même
  // besoin exact : d'où vient cette pièce).
  provenance SourceDonnee?

  createdById String?
  createdBy   User?   @relation("DossierDocumentCreatedBy", fields: [createdById], references: [id])

  packageDocuments TransmissionPackageDocument[]

  @@index([dossierId])
  @@index([organisationId])
  @@index([typeDocumentId])
  @@index([requirementId])
  @@index([statut])
  @@index([clientId])
  @@index([posteTravauxId])
  @@index([replacesId])
}

enum StatutDocument {
  FOURNI
  A_VERIFIER
  VALIDE
  REFUSE
  EXPIRE
  REMPLACE
}

enum PorteeDocument {
  DOSSIER
  CLIENT
  MENAGE
  LOGEMENT
  POSTE_TRAVAUX
  ENTREPRISE
  PARTENAIRE
}

enum ResponsableDocument {
  CLIENT
  COMMERCIAL
  ADMINISTRATIF
  TECHNIQUE
  MAR
  SOUS_TRAITANT
  FOURNISSEUR
  AUTRE
}

enum DestinationTransmission {
  ANAH
  MAR
  CEE
  DELEGATAIRE_CEE
  CONTROLEUR
  SOUS_TRAITANT
  FOURNISSEUR
  CLIENT
  COMPTABILITE
  AUTRE
}

// Référentiel des types de document (P10, section 1) - configurable, remplace
// progressivement l'ancien enum TypeDocument (conservé intact sur
// DossierDocument.type pour ne rien casser). Nommé "Referentiel" plutôt que
// "TypeDocument" pour éviter toute collision avec l'enum historique dans le
// même schéma (un enum et un modèle ne peuvent pas partager un nom Prisma).
model TypeDocumentReferentiel {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  code           String
  nom            String
  categorie      String?
  description    String?
  actif          Boolean       @default(true)
  ordre          Int           @default(0)
  createdAt      DateTime      @default(now())

  documentRequirements DocumentRequirement[]
  dossierDocuments     DossierDocument[]
  packageDocuments     TransmissionPackageDocument[]

  @@unique([organisationId, code])
}

// Exigence documentaire versionnée (P10, section 2) - rattachée selon les
// cas à une étape de programme, une version de règle réglementaire, un type
// de travaux ou une règle interne (organisationId renseigné). Un changement
// futur de version réglementaire ne modifie JAMAIS les exigences déjà liées
// à une ancienne RegleReglementaireVersion (section 13/14) : chaque version
// a ses propres DocumentRequirement, jamais partagés/mutés entre versions.
model DocumentRequirement {
  id             String                   @id @default(cuid())
  organisationId String?
  organisation   Organisation?            @relation(fields: [organisationId], references: [id])
  typeDocumentId String
  typeDocument   TypeDocumentReferentiel  @relation(fields: [typeDocumentId], references: [id])

  etapeProgrammeId String?
  etapeProgramme   EtapeProgramme? @relation(fields: [etapeProgrammeId], references: [id], onDelete: Cascade)
  regleVersionId   String?
  regleVersion     RegleReglementaireVersion? @relation(fields: [regleVersionId], references: [id])
  typeTravaux      TypeTravaux?

  obligatoire      Boolean                @default(true)
  // Condition d'applicabilité libre (ex. "precarite=TRES_MODESTE") -
  // interprétée par le moteur de checklist, jamais évaluée via eval().
  condition        String?
  momentRequis     String?
  responsable      ResponsableDocument?
  destination      DestinationTransmission?
  validiteJours    Int?
  multipleAutorise Boolean                @default(false)
  minCount         Int                    @default(1)
  maxCount         Int?
  portee           PorteeDocument         @default(DOSSIER)
  // Une exigence bloquante empêche la transmission/le passage d'étape tant
  // qu'elle n'est pas satisfaite (section 11/12) - jamais bloquant par
  // défaut pour toutes les étapes, seulement quand explicitement configuré.
  blocking         Boolean                @default(false)
  ordre            Int                    @default(0)
  commentaire      String?
  actif            Boolean                @default(true)
  createdAt        DateTime               @default(now())

  dossierDocuments DossierDocument[]

  @@index([organisationId])
  @@index([etapeProgrammeId])
  @@index([regleVersionId])
  @@index([typeDocumentId])
}

enum StatutTransmissionPackage {
  BROUILLON
  PRET
  TRANSMIS
  ANNULE
}

// Package de transmission (P10, section 16/17) - snapshot figé de ce qui a
// été transmis à un destinataire précis, avec un profil de filtrage
// (aucune fuite documentaire : un sous-traitant ne reçoit jamais un avis
// d'imposition, un délégataire CEE ne reçoit jamais la marge interne).
model TransmissionPackage {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  destinationType DestinationTransmission
  destinationName String?

  status   StatutTransmissionPackage @default(BROUILLON)
  // Contenu exact au moment de la création (section 29) - jamais recalculé
  // rétroactivement, même si les documents/exigences changent ensuite.
  snapshot Json
  comment  String?

  transmittedAt     DateTime?
  transmittedById   String?
  transmittedBy     User?     @relation("TransmissionPackageTransmittedBy", fields: [transmittedById], references: [id])
  externalReference String?

  createdById String?
  createdBy   User?    @relation("TransmissionPackageCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  documents TransmissionPackageDocument[]

  @@index([organisationId])
  @@index([dossierId])
}

model TransmissionPackageDocument {
  id                String                  @id @default(cuid())
  packageId         String
  package           TransmissionPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dossierDocumentId String
  dossierDocument   DossierDocument         @relation(fields: [dossierDocumentId], references: [id])
  typeDocumentId    String?
  typeDocument      TypeDocumentReferentiel? @relation(fields: [typeDocumentId], references: [id])
  version           Int
  ordre             Int                     @default(0)

  @@index([packageId])
  @@index([dossierDocumentId])
}

model Fournisseur {
  id                 String   @id @default(cuid())
  nom                String
  delaiPaiementJours Int?
  telephone          String?
  email              String?
  createdAt          DateTime @default(now())

  commandes Commande[]
}

model Commande {
  id             String        @id @default(cuid())
  dossierId      String
  dossier        Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fournisseurId  String?
  fournisseur    Fournisseur?  @relation(fields: [fournisseurId], references: [id])
  sousTraitantId String?
  sousTraitant   SousTraitant? @relation(fields: [sousTraitantId], references: [id])

  numeroBL            String?
  montantCts          Int // en centimes
  statut              StatutCommande @default(COMMANDEE)
  dateCommande        DateTime       @default(now())
  dateLivraisonPrevue DateTime?
  dateLivraisonReelle DateTime?

  createdAt DateTime @default(now())

  @@index([dossierId])
  @@index([fournisseurId])
}

model Tache {
  id           String      @id @default(cuid())
  dossierId    String
  dossier      Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type         TypeTache
  titre        String
  description  String?
  dateEcheance DateTime
  statut       StatutTache @default(A_FAIRE)
  assigneAId   String?
  assigneA     User?       @relation(fields: [assigneAId], references: [id])

  // Renseignés uniquement pour les tâches générées automatiquement par le
  // moteur de workflow (src/lib/workflow.ts) - la contrainte unique ci-
  // dessous est la garantie d'idempotence : recalculer plusieurs fois ne
  // crée jamais deux fois la même tâche pour une même étape+modèle.
  dossierEtapeId     String?
  dossierEtape       DossierEtape?     @relation(fields: [dossierEtapeId], references: [id], onDelete: Cascade)
  modeleTacheEtapeId String?
  modeleTacheEtape   ModeleTacheEtape? @relation(fields: [modeleTacheEtapeId], references: [id])

  // Relance : renseignés uniquement sur les tâches de type relance (créées
  // à la main ou par evaluateRelanceRules()). La même tâche reste ouverte
  // et se met à jour à chaque relance plutôt que d'en créer une nouvelle -
  // regleRelanceId + la contrainte unique ci-dessous garantissent qu'une
  // même règle ne crée jamais deux tâches pour la même étape.
  derniereRelanceAt DateTime?
  nombreRelances    Int       @default(0)
  prochaineRelanceAt DateTime?
  regleRelanceId    String?
  regleRelance      RegleRelance? @relation(fields: [regleRelanceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dossierEtapeId, modeleTacheEtapeId])
  @@unique([dossierEtapeId, regleRelanceId])
  @@index([dossierId])
  @@index([statut, dateEcheance])
}

// Règle paramétrable simple de relance automatique : après apresJours dans
// une étape (matchée par code, ou par flux si aucun code précis), créer une
// tâche de relance ; recurrenceJours/maxRelances bornent les relances
// suivantes. evaluateRelanceRules() est idempotent - à appeler manuellement
// ou à l'ouverture du dashboard pour cette V1, pas de cron.
model RegleRelance {
  id                String        @id @default(cuid())
  organisationId    String
  organisation      Organisation  @relation(fields: [organisationId], references: [id])
  nom               String
  typeFlux          TypeFluxEtape
  // Code d'une EtapeProgramme précise (ex. "INSTRUCTION_ANAH") pour cibler
  // une étape exacte ; laisser vide pour matcher tout étape du typeFlux.
  typeAction        String?
  apresJours        Int
  recurrenceJours   Int?
  maxRelances       Int?
  roleResponsable   Role?
  actif             Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  taches Tache[]

  @@index([organisationId])
}

// Mouvement financier daté et traçable, unitaire (un encaissement, un
// paiement, une commission...). Coexiste avec les compteurs cumulés déjà
// présents sur Dossier (montantEncaisseClient/MPR/CEE) qui restent la
// source utilisée par l'UI actuelle - ce modèle est la fondation d'un
// futur grand livre détaillé, pas encore branché nulle part par défaut.
model MouvementFinancier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  type      TypeMouvementFinancier
  categorie CategorieMouvementFinancier

  payeur       String? // libellé libre : "Client", "ANAH", "Délégataire CEE X"...
  beneficiaire String?
  // Type de partie prenante (P6) - complète payeur/beneficiaire (le nom
  // libre) sans les remplacer, pour permettre les agrégations génériques
  // (créances = ENTREE où payeurType = CLIENT, dettes = SORTIE non soldée...).
  payeurType       PartiePrenante?
  beneficiaireType PartiePrenante?

  montantPrevuCts Int?
  montantReelCts  Int?
  datePrevue      DateTime?
  dateReelle      DateTime?

  // Quand ce mouvement devient exigible (P6, section 17) - champ informatif
  // pour la V1, non branché à un moteur événementiel automatique.
  exigibleQuand ConditionExigibilite?

  statut StatutMouvementFinancier @default(PREVU)
  // Origine libre - utiliser la valeur "SOURCE_EXISTANTE_AGREGEE" pour tout
  // mouvement reconstitué depuis les compteurs agrégés existants (sans date
  // métier réelle connue), afin de ne jamais le confondre avec un mouvement
  // réellement daté et tracé.
  origine     String?
  commentaire String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossierId])
  @@index([organisationId])
  @@index([statut])
}

// Journal d'audit minimal - qui a fait quoi, quand. entityId est une chaîne
// libre (pas de FK) car une même ligne peut référencer n'importe quel type
// d'entité (document, tâche, poste de travaux...) sans imposer une relation
// Prisma par type audité.
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  action     String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([entityType, entityId])
}

// ============================================================
// Moteur de programmes / workflows paramétrables
//
// Programme -> plusieurs ProgrammeVersion -> plusieurs EtapeProgramme
// (la définition du modèle, éditable tant que la version n'est pas
// publiée). Quand une ProgrammeVersion est affectée à un Dossier, ses
// DossierEtape (l'instance réelle pour CE dossier) sont créées et tenues
// à jour par recalculateDossierWorkflow() (src/lib/workflow.ts) - jamais
// à la main, jamais dupliquées. Une version publiée est figée : pour la
// faire évoluer, on la duplique plutôt que de la modifier en place, afin
// que les dossiers déjà engagés ne changent jamais de comportement.
// ============================================================

model Programme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  nom            String
  code           String
  description    String?
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  versions ProgrammeVersion[]

  @@unique([organisationId, code])
  @@index([organisationId])
}

model ProgrammeVersion {
  id             String    @id @default(cuid())
  programmeId    String
  programme      Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  numeroVersion  String
  nomVersion     String?
  dateDebutEffet DateTime?
  dateFinEffet   DateTime?
  actif          Boolean   @default(true)
  // Fige la structure (étapes/dépendances/tâches modèles) dès que true -
  // dupliquer pour modifier. Voir requireVersionModifiable() côté serveur.
  publie         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  etapes   EtapeProgramme[]
  dossiers Dossier[]

  @@unique([programmeId, numeroVersion])
  @@index([programmeId])
}

model EtapeProgramme {
  id                 String           @id @default(cuid())
  programmeVersionId String
  programmeVersion   ProgrammeVersion @relation(fields: [programmeVersionId], references: [id], onDelete: Cascade)
  code               String
  nom                String
  description        String?
  ordre              Int              @default(0)
  typeFlux           TypeFluxEtape    @default(AUTRE)
  delaiNormalJours   Int?
  delaiAlerteJours   Int?
  roleResponsable    Role?
  obligatoire        Boolean          @default(true)
  actif              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  dossierEtapes   DossierEtape[]
  // Étapes dont CETTE étape dépend (doivent être TERMINE avant elle).
  dependances     EtapeDependance[] @relation("Etape")
  // Étapes qui dépendent de CETTE étape.
  dependuesPar    EtapeDependance[] @relation("DependsOn")
  documentsRequis EtapeDocumentRequis[]
  modelesTaches   ModeleTacheEtape[]
  documentRequirements DocumentRequirement[]

  @@unique([programmeVersionId, code])
  @@index([programmeVersionId])
}

model EtapeDependance {
  id               String              @id @default(cuid())
  etapeId          String
  etape            EtapeProgramme      @relation("Etape", fields: [etapeId], references: [id], onDelete: Cascade)
  dependsOnEtapeId String
  dependsOnEtape   EtapeProgramme      @relation("DependsOn", fields: [dependsOnEtapeId], references: [id], onDelete: Cascade)
  type             TypeDependanceEtape @default(ALL_COMPLETED)
  createdAt        DateTime            @default(now())

  @@unique([etapeId, dependsOnEtapeId])
  @@index([etapeId])
  @@index([dependsOnEtapeId])
}

// Déclare qu'une étape nécessite un document d'un type donné pour être
// considérée complète. Intégration additive au système Documents existant
// (TypeDocument, DossierDocument) - pas de refonte : la présence est
// simplement vérifiée en cherchant un DossierDocument du dossier dont le
// type correspond.
model EtapeDocumentRequis {
  id               String         @id @default(cuid())
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id], onDelete: Cascade)
  typeDocument     TypeDocument
  obligatoire      Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([etapeProgrammeId, typeDocument])
  @@index([etapeProgrammeId])
}

// Modèle de tâche générée automatiquement quand une DossierEtape devient
// A_FAIRE. roleResponsable sert de repli si aucun utilisateur précis n'est
// déterminable automatiquement (V1 : pas de moteur de répartition).
model ModeleTacheEtape {
  id               String         @id @default(cuid())
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id], onDelete: Cascade)
  titre            String
  description      String?
  type             TypeTache      @default(AUTRE)
  delaiJours       Int            @default(0)
  roleResponsable  Role?
  obligatoire      Boolean        @default(true)
  actif            Boolean        @default(true)
  createdAt        DateTime       @default(now())

  taches Tache[]

  @@index([etapeProgrammeId])
}

// Instance réelle d'une étape sur un dossier précis (à distinguer de
// EtapeProgramme, qui n'est qu'une définition). Une ligne par
// (dossier, étape) - créée et recalculée uniquement par
// recalculateDossierWorkflow(), jamais par une saisie manuelle directe.
model DossierEtape {
  id               String         @id @default(cuid())
  organisationId   String
  organisation     Organisation   @relation(fields: [organisationId], references: [id])
  dossierId        String
  dossier          Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id])

  statut         StatutDossierEtape @default(NON_DISPONIBLE)
  dateDisponible DateTime?
  dateDebut      DateTime?
  dateEcheance   DateTime?
  dateTerminee   DateTime?

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id])

  commentaire   String?
  bloque        Boolean @default(false)
  raisonBlocage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taches Tache[]

  @@unique([dossierId, etapeProgrammeId])
  @@index([organisationId])
  @@index([dossierId])
  @@index([etapeProgrammeId])
  @@index([statut])
}

// ============================================================
// Moteur réglementaire versionné (P7).
//
// Principe : une règle réglementaire (ex. fiche CEE BAR-TH-171) n'est
// jamais un simple if/else sans historique. RegleReglementaire est la
// fiche elle-même (identité stable) ; RegleReglementaireVersion porte les
// dates d'effet, la source officielle et le code de formule whitelisté ;
// BaremeReglementaire porte les valeurs (coefficients/forfaits) de cette
// version, jamais codées en dur dans une fonction. Une fois publiée et
// utilisée par un calcul, une version reste figée pour toujours (section 1
// du prompt) - un dossier historique garde le résultat produit par LA
// version en vigueur à sa date d'engagement, jamais recalculé
// silencieusement avec la version courante (section 9).
//
// RÈGLE OFFICIELLE GLOBALE (RegleReglementaire/Version/Bareme) - pas de
// organisationId : une fiche CEE BAR-TH-171 et ses forfaits sont les mêmes
// pour tout le monde, ce n'est pas une donnée commerciale (section 31).
// Ne pas dupliquer une fiche réglementaire par organisation cliente du
// SaaS. Seul TarifDelegataireCee (la valorisation commerciale négociée
// avec un délégataire) est scopé par organisationId - cf. plus bas.
// ============================================================

enum SecteurReglementaire {
  BAR
  BAT
  IND
  AGRI
  TRA
  RES
  AUTRE
}

enum StatutEligibiliteReglementaire {
  ELIGIBLE
  ELIGIBLE_PROBABLE
  A_CONFIRMER
  NON_ELIGIBLE
  BLOQUE
  DONNEES_INSUFFISANTES
}

enum TypeCalculReglementaire {
  SIMULATION
  OFFICIEL
}

model RegleReglementaire {
  id          String               @id @default(cuid())
  code        String               @unique // ex. "BAR-TH-171"
  famille     String // ex. "CEE" - assez générique pour accueillir MPR/ANAH/autres plus tard (section 25)
  secteur     SecteurReglementaire
  nom         String
  description String?
  actif       Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  versions RegleReglementaireVersion[]
}

model RegleReglementaireVersion {
  id            String    @id @default(cuid())
  regleId       String
  regle         RegleReglementaire @relation(fields: [regleId], references: [id])
  numeroVersion String

  dateDebutEffet DateTime
  dateFinEffet   DateTime?
  publie         Boolean   @default(false)

  // Code de formule whitelisté (jamais de code arbitraire depuis l'UI -
  // section 19) - doit correspondre à une clé de FORMULES dans
  // src/lib/reglementaire/formulas.ts.
  formulaCode String

  sourceNom             String
  sourceReference       String?
  sourceUrl             String?
  sourceDatePublication DateTime?
  commentaire           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baremes BaremeReglementaire[]
  calculs CalculReglementaire[]
  documentRequirements DocumentRequirement[]

  @@unique([regleId, numeroVersion])
  @@index([regleId])
}

// Valeurs/forfaits d'une version - jamais un if/else zone caché dans le
// code (section 6). `valeur` est un entier (kWh cumac ou tout autre
// coefficient réglementaire entier) : aucune donnée réglementaire n'est
// stockée en flottant.
model BaremeReglementaire {
  id            String                     @id @default(cuid())
  ruleVersionId String
  ruleVersion   RegleReglementaireVersion  @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  cle           String
  valeur        Int
  metadata      Json?
  createdAt     DateTime                   @default(now())

  @@unique([ruleVersionId, cle])
  @@index([ruleVersionId])
}

// Un calcul réglementaire enregistré (section 10) - la trace immuable de
// "quelles données, quelle version, quel résultat". SIMULATION ne sert
// jamais de référence officielle et peut être recalculée librement ;
// OFFICIEL est celui retenu pour engager/transmettre un dossier et ne doit
// jamais être écrasé (section 11) - un nouveau calcul officiel crée une
// NOUVELLE ligne, il ne modifie pas l'ancienne.
model CalculReglementaire {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  posteTravauxId String?
  posteTravaux   DossierPosteTravaux? @relation("PosteCalculsHistorique", fields: [posteTravauxId], references: [id])

  ruleVersionId String
  ruleVersion   RegleReglementaireVersion @relation(fields: [ruleVersionId], references: [id])

  type           TypeCalculReglementaire
  dateEngagement DateTime
  inputs         Json
  resultat       Json
  kwhCumac       Int?

  statutEligibilite StatutEligibiliteReglementaire

  // Override manuel (section 24) - ne modifie JAMAIS la règle elle-même,
  // seulement ce calcul précis. Une raison est obligatoire (appliqué au
  // niveau Server Action, pas seulement en UI).
  overrideStatutEligibilite StatutEligibiliteReglementaire?
  overrideKwhCumac          Int?
  overrideReason            String?
  overrideById              String?
  overrideBy                User?     @relation("CalculReglementaireOverrideBy", fields: [overrideById], references: [id])
  overrideAt                DateTime?

  createdById String?
  createdBy   User?    @relation("CalculReglementaireCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  posteActifPour DossierPosteTravaux? @relation("PosteCalculActif")

  @@index([organisationId])
  @@index([dossierId])
  @@index([posteTravauxId])
  @@index([ruleVersionId])
}

// Valorisation commerciale (section 13/14) - SÉPARÉE du calcul
// réglementaire : kWh cumac ≠ valeur €. Propre à l'organisation (les taux
// négociés par BHM avec un délégataire ne concernent pas un autre client
// SaaS). tauxCtsParMwhc en centimes d'euro par MWh cumac (entier, jamais
// de flottant sur un montant monétaire, cf. section 14 du prompt).
model TarifDelegataireCee {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  delegataireId  String
  delegataire    DelegataireCee @relation(fields: [delegataireId], references: [id])

  // null = tarif générique applicable à toutes les fiches CEE de ce délégataire
  ficheCode String?
  // Catégorie du ménage/bénéficiaire - "TRES_MODESTE" | "CLASSIQUE" pour la
  // fiche pilote (même distinction binaire que le calculateur existant),
  // laissé en String libre pour rester extensible sans migration.
  categorie String

  tauxCtsParMwhc     Int
  dateDebut          DateTime
  dateFin            DateTime?
  delaiPaiementJours Int?
  actif              Boolean   @default(true)
  commentaire        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([delegataireId])
}

// ============================================================
// Moteur d'étude / scénarios / recommandation (P8).
//
// Une étude SIMULATION est un calcul dynamique, non contractuel, pas
// nécessairement sauvegardé (le commercial peut simuler sans jamais
// enregistrer). Une étude OFFICIEL est un snapshot immuable : ni
// inputsSnapshot ni resultsSnapshot ne sont jamais modifiés après coup -
// une nouvelle étude officielle crée une nouvelle ligne (version = max+1
// pour ce dossier), l'ancienne reste strictement inchangée (section 20/44
// du prompt P8). inputHash permet de détecter si les données du dossier
// ont changé depuis (isStudyStale, section 28/29) sans recalculer à
// chaque affichage.
// ============================================================

enum ModeEtude {
  SIMULATION
  OFFICIEL
}

model EtudeDossier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  version Int       @default(1)
  mode    ModeEtude

  inputsSnapshot  Json
  resultsSnapshot Json
  // Hash stable des données critiques ayant produit cette étude (section
  // 29) - permet de détecter l'obsolescence sans recalculer, jamais un
  // simple timestamp (un dossier peut être touché sans que rien de
  // pertinent pour l'étude ne change).
  inputHash String

  recommendedScenarioId String?

  // Scénario retenu par un humain (section 21) - distinct de
  // recommendedScenarioId (calculé par le moteur) : on ne prétend jamais
  // qu'un scénario est "le meilleur" de façon certaine, mais un utilisateur
  // peut choisir d'en retenir un. Mutable après création (contrairement à
  // inputsSnapshot/resultsSnapshot qui restent figés) car c'est un simple
  // pointeur de décision, pas une donnée de calcul historique.
  selectedScenarioId String?
  selectedAt         DateTime?
  selectedById       String?
  selectedBy         User?     @relation("EtudeDossierSelectedBy", fields: [selectedById], references: [id])

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([dossierId, version])
  @@index([organisationId])
  @@index([dossierId])
}

// ============================================================
// P9 - poste de travail commercial (Lead -> qualification -> logement ->
// RDV -> étude P8 -> vente/dossier). Architecture additive : ne modifie
// aucun modèle P5-P8, ne reproduit aucune formule P6/P7/P8 - collecte et
// structure les données que ces moteurs lisent déjà (Dossier/Client/
// DossierPosteTravaux). Voir src/lib/leads, src/lib/questionnaire,
// src/lib/connectors.
// ============================================================

// Tables paramétrables (même pattern que DossierType/DossierStatus/...) -
// globales, pas org-scopées, cohérent avec le reste du référentiel.
model LeadSource {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  leads Lead[]
}

// Pipeline commercial (section 3) - volontairement distinct de
// DossierStatus/StatutAnah/StatutCee/StatutTravaux : un lead n'a pas encore
// de dossier, et un statut "SIGNÉ" ici ne dit rien sur l'avancement
// administratif ANAH/CEE/travaux qui commence après conversion.
model LeadPipelineStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  leads Lead[]
  resultatsAppelPropositions ResultatAppel[]
  historiqueAncienStatut LeadStatusHistory[] @relation("LeadStatusHistoryOld")
  historiqueNouveauStatut LeadStatusHistory[] @relation("LeadStatusHistoryNew")
}

// Résultat d'un appel/contact (section 18) - peut proposer un enchaînement
// (nouveau statut pipeline + délai de rappel) sans être un moteur de règles :
// une simple valeur par défaut que l'action d'enregistrement applique si
// l'utilisateur ne la modifie pas explicitement.
model ResultatAppel {
  id                      String   @id @default(cuid())
  key                     String   @unique
  label                   String
  ordre                   Int      @default(0)
  actif                   Boolean  @default(true)
  proposeStatutId         String?
  proposeStatut           LeadPipelineStatus? @relation(fields: [proposeStatutId], references: [id])
  proposeDelaiRappelJours Int?
  createdAt               DateTime @default(now())

  leadsDernierResultat Lead[] @relation("LeadDernierResultat")
  interactions         InteractionCommerciale[]
}

// Lead/opportunité (section 1) - ne duplique jamais Client : ne devient
// Client/Dossier qu'au moment explicite de la conversion
// (convertLeadToDossier, idempotente via dossierId unique ci-dessous).
model Lead {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  sourceId     String?
  source       LeadSource? @relation(fields: [sourceId], references: [id])
  sourceDetail String?

  prenom             String
  nom                String
  telephone          String?
  // Sortie de normalizePhoneNumber() (src/lib/phone.ts) - jamais saisie
  // directement, utilisée pour la détection de doublons (section 15/16).
  telephoneNormalise String?
  email              String?
  adresse            String?
  codePostal         String?
  ville              String?

  commercialId      String?
  commercial        User? @relation("LeadCommercial", fields: [commercialId], references: [id])
  teleprospecteurId String?
  teleprospecteur   User? @relation("LeadTeleprospecteur", fields: [teleprospecteurId], references: [id])

  statutId          String
  statut            LeadPipelineStatus @relation(fields: [statutId], references: [id])
  temperature       TemperatureLead    @default(TIEDE)
  dernierResultatId String?
  dernierResultat   ResultatAppel?     @relation("LeadDernierResultat", fields: [dernierResultatId], references: [id])
  prochainContactAt DateTime?
  notes             String?

  // Claim léger (section 23) - empêche que deux téléprospecteurs appellent
  // le même lead en même temps sans verrou lourd/websocket : une expiration
  // simple (claimExpiresAt) rend le lead de nouveau disponible tout seul.
  claimedById    String?
  claimedBy      User?     @relation("LeadClaimedBy", fields: [claimedById], references: [id])
  claimedAt      DateTime?
  claimExpiresAt DateTime?

  // Renseignés uniquement après conversion (section 14). dossierId est
  // UNIQUE : c'est la garantie au niveau base qu'un lead ne peut jamais
  // pointer vers deux dossiers, quel que soit le nombre de clics.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  dossierId   String?   @unique
  dossier     Dossier?  @relation(fields: [dossierId], references: [id])
  convertedAt DateTime?

  createdById String?
  createdBy   User?    @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logement              Logement?
  interactions          InteractionCommerciale[]
  rdvs                  Rdv[]
  reponsesQuestionnaire ReponseQuestionnaire[]
  statusHistory         LeadStatusHistory[]

  @@index([organisationId])
  @@index([commercialId])
  @@index([teleprospecteurId])
  @@index([statutId])
  @@index([telephoneNormalise])
  @@index([email])
  @@index([prochainContactAt])
  @@index([claimedById])
}

enum TemperatureLead {
  FROID
  TIEDE
  CHAUD
}

// Historique des changements de statut pipeline (P9, finition section 38) -
// permet au funnel de conversion de compter "a déjà atteint QUALIFIÉ" même
// si le lead est ensuite marqué PERDU, ce que le seul statut courant du
// Lead ne peut pas exprimer. Une ligne par changement, jamais réécrite.
model LeadStatusHistory {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  oldStatusId String?
  oldStatus   LeadPipelineStatus? @relation("LeadStatusHistoryOld", fields: [oldStatusId], references: [id])
  newStatusId String
  newStatus   LeadPipelineStatus  @relation("LeadStatusHistoryNew", fields: [newStatusId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([newStatusId])
}

// Fiche logement centrale (section 4) - rattachée à EXACTEMENT un
// propriétaire (lead, client ou dossier) à un instant donné ; toujours
// mutable (comme Client), pas un snapshot figé. Aucun champ obligatoire au-
// delà de l'identité : un logement peut être créé quasi-vide et rempli
// progressivement pendant l'appel.
model Logement {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  leadId    String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?  @unique
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dossierId String?  @unique
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  adresse    String?
  complement String?
  codePostal String?
  ville      String?
  latitude   Float?
  longitude  Float?

  typeBatiment       TypeBatimentLogement?
  typeHabitat        TypeHabitatLogement?
  anneeConstruction  Int?
  surfaceHabitableM2 Float?
  surfaceChauffeeM2  Float?
  nombreNiveaux      Int?
  nombreLogements    Int?

  chauffagePrincipal       EnergieLogement?
  equipementChauffage      String?
  anneeEquipementChauffage Int?
  ecs                      Boolean?
  energieEcs               EnergieLogement?
  climatisation            Boolean?
  dpe                      String?
  consommationAnnuelleKwh  Int?

  isolationMurs        String?
  isolationCombles     String?
  isolationRampants    String?
  isolationPlancherBas String?
  isolationFenetres    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  champsProvenance ChampProvenance[]

  @@index([organisationId])
}

enum TypeBatimentLogement {
  MAISON
  APPARTEMENT
}

enum TypeHabitatLogement {
  INDIVIDUEL
  COLLECTIF
}

enum EnergieLogement {
  ELECTRICITE
  GAZ
  FIOUL
  BOIS
  PAC
  RESEAU_CHALEUR
  AUTRE
}

enum SourceDonnee {
  CLIENT
  COMMERCIAL
  VISITE
  AUDIT
  API
  DOCUMENT
  IMPORT
  AUTRE
}

enum ConfianceDonnee {
  DECLARE
  ESTIME
  VERIFIE
}

// Provenance/confiance par champ (section 5) - volontairement UNE ligne par
// (logement, champ) plutôt qu'un historique complet : suffisant pour savoir
// d'où vient une valeur et porter une éventuelle proposition externe en
// attente (sections 29/30), sans alourdir P9 d'un système de versionning
// champ par champ.
model ChampProvenance {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  logementId     String
  logement       Logement     @relation(fields: [logementId], references: [id], onDelete: Cascade)

  champ     String
  source    SourceDonnee
  confiance ConfianceDonnee @default(DECLARE)

  // Proposition externe en attente (section 29) - n'écrase JAMAIS
  // valeurActuelle/source/confiance tant qu'elle n'a pas été acceptée
  // explicitement (section 30 : traçabilité complète de l'acceptation).
  valeurProposee   String?
  sourceProposee   SourceDonnee?
  referenceExterne String?
  recupereeAt      DateTime?
  accepteeById     String?
  accepteeBy       User?     @relation("ChampProvenanceAcceptedBy", fields: [accepteeById], references: [id])
  accepteeAt       DateTime?
  refuseeAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([logementId, champ])
  @@index([organisationId])
}

// --- Questionnaire configurable (section 8) ---------------------------
//
// Une QuestionnaireVersion publiée est figée : publier une nouvelle version
// ne modifie jamais les Question/OptionQuestion/ConditionQuestion d'une
// version déjà publiée, exactement comme RegleReglementaireVersion en P7 -
// les réponses historiques (ReponseQuestion) restent donc interprétables
// même si le questionnaire évolue ensuite.
model Questionnaire {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  code           String
  nom            String
  actif          Boolean       @default(true)
  createdAt      DateTime      @default(now())

  versions QuestionnaireVersion[]

  @@unique([organisationId, code])
}

model QuestionnaireVersion {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
  numeroVersion   Int
  publiee         Boolean       @default(false)
  publieeAt       DateTime?
  createdAt       DateTime      @default(now())

  questions Question[]
  reponses  ReponseQuestionnaire[]

  @@unique([questionnaireId, numeroVersion])
}

enum TypeQuestion {
  TEXT
  NUMBER
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
  DATE
}

model Question {
  id                     String               @id @default(cuid())
  questionnaireVersionId String
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)

  // Identifiant stable réutilisé par les conditions et le mapping vers les
  // champs métier (section 10) - jamais l'id technique, qui changerait
  // d'une version à l'autre.
  code        String
  libelle     String
  type        TypeQuestion
  unite       String?
  ordre       Int          @default(0)
  obligatoire Boolean      @default(false)
  // Section de l'écran de qualification (A_CONTACT..H_PROCHAINE_ACTION,
  // section 6) - texte libre volontairement, pas un enum : ce sont des
  // regroupements d'affichage, pas une donnée métier.
  section     String
  // Convention documentée "Modele.champ" (ex. "Logement.surfaceChauffeeM2")
  // interprétée par src/lib/questionnaire/mapping.ts - pas une vraie FK
  // dynamique, seulement pour que la réponse ne reste jamais uniquement
  // dans un JSON opaque (section 10).
  champMappe  String?

  options               OptionQuestion[]
  conditionsAffichage   ConditionQuestion[] @relation("QuestionConditionnee")
  conditionsDeclenchees ConditionQuestion[] @relation("QuestionDeclenchante")
  reponses              ReponseQuestion[]

  @@unique([questionnaireVersionId, code])
  @@index([questionnaireVersionId])
}

model OptionQuestion {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code       String
  libelle    String
  ordre      Int      @default(0)

  @@unique([questionId, code])
}

// Une question conditionnée n'est affichée que si la question déclenchante
// a reçu la valeur attendue (code d'option, ou "true"/"false" pour YES_NO) -
// évalué par src/lib/questionnaire/engine.ts, jamais codé en dur dans un
// composant React (section 7).
model ConditionQuestion {
  id                     String   @id @default(cuid())
  questionId             String
  question               Question @relation("QuestionConditionnee", fields: [questionId], references: [id], onDelete: Cascade)
  questionDeclenchanteId String
  questionDeclenchante   Question @relation("QuestionDeclenchante", fields: [questionDeclenchanteId], references: [id], onDelete: Cascade)
  valeurAttendue         String

  @@index([questionId])
  @@index([questionDeclenchanteId])
}

// Une instance de questionnaire rempli pour un lead donné, sur UNE version
// figée (jamais migrée automatiquement vers une version plus récente).
model ReponseQuestionnaire {
  id                     String               @id @default(cuid())
  organisationId         String
  organisation           Organisation         @relation(fields: [organisationId], references: [id])
  leadId                 String
  lead                   Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  questionnaireVersionId String
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reponses ReponseQuestion[]

  @@unique([leadId, questionnaireVersionId])
  @@index([organisationId])
}

model ReponseQuestion {
  id                     String               @id @default(cuid())
  reponseQuestionnaireId String
  reponseQuestionnaire   ReponseQuestionnaire @relation(fields: [reponseQuestionnaireId], references: [id], onDelete: Cascade)
  questionId             String
  question               Question             @relation(fields: [questionId], references: [id])

  valeurTexte   String?
  valeurNombre  Float?
  valeurBool    Boolean?
  valeurDate    DateTime?
  // Codes des OptionQuestion sélectionnées (MULTI_SELECT) - Json plutôt
  // qu'un tableau natif (non supporté par le provider MySQL de Prisma).
  valeurOptions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reponseQuestionnaireId, questionId])
}

enum TypeInteraction {
  APPEL
  EMAIL
  SMS
  VISITE
  AUTRE
}

// Historique de contact simple (section 19) - pas de téléphonie native P9 :
// type/durée/notes sont saisis manuellement par l'utilisateur.
model InteractionCommerciale {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])

  type              TypeInteraction
  resultatId        String?
  resultat          ResultatAppel?  @relation(fields: [resultatId], references: [id])
  notes             String?
  dureeMinutes      Int?
  prochaineActionAt DateTime?

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([leadId])
}

enum TypeRdv {
  TELEPHONIQUE
  VISITE
  AUTRE
}

enum StatutRdv {
  PLANIFIE
  CONFIRME
  REALISE
  ANNULE
}

// RDV (section 17) - reste interne au CRM en P9 (pas d'intégration Google
// Calendar). Peut être rattaché à un lead OU à un dossier (après
// conversion), jamais aux deux à la fois.
model Rdv {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dossierId      String?
  dossier        Dossier?     @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  date         DateTime
  type         TypeRdv
  commercialId String?
  commercial   User?     @relation("RdvCommercial", fields: [commercialId], references: [id])
  adresse      String?
  commentaire  String?
  statut       StatutRdv @default(PLANIFIE)

  createdById String?
  createdBy   User?    @relation("RdvCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organisationId])
  @@index([leadId])
  @@index([dossierId])
}
