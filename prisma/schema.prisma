// Prisma schema - BHM CRM
// Montants monétaires stockés en centimes (Int) - jamais de float sur de l'argent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Rôles existants (ADMIN, COMMERCIAL, COMPTA) conservés tels quels pour ne
// rien casser sur les comptes déjà créés. Nouveaux rôles ajoutés en vue du
// futur requireRole()/hasPermission() (non implémenté dans cette étape) :
// COMPTABILITE est le nom canonique désormais pour ce rôle - COMPTA reste
// valide uniquement pour compatibilité avec des comptes existants.
enum Role {
  ADMIN
  COMMERCIAL
  COMPTA
  ADMINISTRATIF
  REGIE
  SOUS_TRAITANT
  COMPTABILITE
  TECHNIQUE
}

enum Precarite {
  TRES_MODESTE
  MODESTE
  INTERMEDIAIRE
  SUPERIEUR
}

enum ZoneClimatique {
  H1
  H2
  H3
}

enum TypeTravaux {
  // Chauffage et eau chaude sanitaire
  RACCORDEMENT_RESEAU_CHALEUR
  CHAUFFE_EAU_THERMODYNAMIQUE
  PAC_AIR_EAU
  PAC_AIR_AIR
  PAC_GEOTHERMIQUE_SOLAROTHERMIQUE
  CHAUFFE_EAU_SOLAIRE_INDIVIDUEL
  CHAUFFAGE_SOLAIRE_COMBINE
  PVT_EAU
  POELE_BUCHES
  POELE_GRANULES
  CHAUDIERE_BOIS_MANUELLE
  CHAUDIERE_BOIS_AUTOMATIQUE
  FOYER_FERME_INSERT
  // Isolation thermique
  ITE
  ITI
  COMBLES
  RAMPANTS
  TOITURE_TERRASSE
  PAROIS_VITREES
  // Autres travaux
  AUDIT_ENERGETIQUE
  DEPOSE_CUVE_FIOUL
  VMC
  // Historique / autres
  BALLON_THERMODYNAMIQUE
  AUTRE
}

enum TypeTache {
  RELANCE_CLIENT
  RELANCE_CEE
  RELANCE_ANAH
  RELANCE_FOURNISSEUR
  RELANCE_SOUS_TRAITANT
  AUTRE
}

enum StatutTache {
  A_FAIRE
  FAIT
  ANNULE
}

enum StatutCommande {
  COMMANDEE
  LIVREE
  RETIREE
  ANNULEE
}

enum TypeDocument {
  DEVIS
  AUDIT
  PHOTO_VISITE
  PHOTO_CHANTIER
  AUTRE
}

enum TypeMouvementFinancier {
  ENTREE
  SORTIE
}

enum CategorieMouvementFinancier {
  ENCAISSEMENT_CLIENT
  ENCAISSEMENT_ANAH
  ENCAISSEMENT_MPR
  ENCAISSEMENT_CEE
  PAIEMENT_SOUS_TRAITANT
  PAIEMENT_FOURNISSEUR
  COMMISSION_COMMERCIALE
  COMMISSION_REGIE
  COMMISSION_APPORTEUR
  AUTRE_ENTREE
  AUTRE_SORTIE
}

enum StatutMouvementFinancier {
  PREVU
  A_RECEVOIR
  A_PAYER
  PARTIEL
  RECU
  PAYE
  ANNULE
  EN_RETARD
}

// Flux métier auquel une étape de programme se rattache (vue synthétique,
// indépendant des colonnes statut*Id existantes sur Dossier).
enum TypeFluxEtape {
  COMMERCIAL
  ADMINISTRATIF
  ANAH
  CEE
  TRAVAUX
  FINANCIER
  AUTRE
}

enum StatutDossierEtape {
  NON_DISPONIBLE
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  BLOQUE
  TERMINE
  IGNORE
  ANNULE
}

// Une seule règle de dépendance pour cette V1 : l'étape ne devient
// disponible que lorsque TOUTES ses dépendances sont TERMINE. L'enum
// existe pour permettre d'ajouter des règles plus tard sans migration
// structurelle (ANY_COMPLETED, etc.).
enum TypeDependanceEtape {
  ALL_COMPLETED
}

// Une entreprise/organisation cliente de la plateforme. Une seule
// organisation active aujourd'hui (BHM), mais toutes les entités
// structurantes (User, Client, Dossier) y sont déjà rattachées pour
// permettre un cloisonnement multi-entreprise ultérieur sans nouvelle
// migration lourde.
model Organisation {
  id        String   @id @default(cuid())
  nom       String
  slug      String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  clients              Client[]
  dossiers             Dossier[]
  mouvementsFinanciers MouvementFinancier[]
  auditLogs            AuditLog[]
  programmes           Programme[]
  dossierEtapes        DossierEtape[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMMERCIAL)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  tachesAssignees        Tache[]
  dossiersCrees          Dossier[]
  mouvementsCrees        MouvementFinancier[]
  auditLogs              AuditLog[]
  dossierEtapesAssignees DossierEtape[]

  @@index([organisationId])
}

// Listes paramétrables depuis /parametrage - remplacent d'anciens enums figés
// pour permettre à l'admin d'ajouter/renommer/désactiver sans déploiement.
model DossierType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model DossierStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model ModePaiement {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Accompagnateurs Rénov (MAR) - gérés depuis /parametrage, choisis sur les
// dossiers de rénovation d'ampleur.
model Mar {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Équipes internes ("régie") - alternative à la sous-traitance pour la pose
// d'un poste de travaux, gérées depuis /parametrage.
model Regie {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  postesTravaux DossierPosteTravaux[]
}

// Délégataires CEE - gérés depuis /parametrage, chaque dossier avec de la
// prime CEE en a un (obligatoire pour percevoir la prime).
model DelegataireCee {
  id        String   @id @default(cuid())
  nom       String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Taux de rachat CEE (€ par MCumac, en centimes) proposés par ce
  // délégataire, et délai de paiement après dépôt du dossier chez lui.
  rachatTresModesteCts Int?
  rachatClassiqueCts   Int?
  delaiPaiementJours   Int?

  dossiers Dossier[]
}

// Statuts du suivi administratif ANAH (spécifique rénovation d'ampleur),
// distincts du statut général du dossier.
model StatutAnah {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Statut du flux CEE, indépendant du statut général et du statut ANAH -
// même pattern paramétrable que StatutAnah (géré depuis /parametrage).
model StatutCee {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

// Statut du flux travaux/chantier, indépendant des autres flux - même
// pattern paramétrable que StatutAnah.
model StatutTravaux {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model Client {
  id             String          @id @default(cuid())
  prenom         String
  nom            String
  email          String?
  telephone      String?
  adresse        String?
  codePostal     String?
  ville          String?
  precarite      Precarite?
  zoneClimatique ZoneClimatique?

  // Infos techniques du logement
  surfaceHabitableM2 Int?
  anneeConstruction  Int?

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossiers Dossier[]

  @@index([organisationId])
}

model Dossier {
  id        String @id @default(cuid())
  reference String @unique
  clientId  String
  client    Client @relation(fields: [clientId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  typeId String
  type   DossierType @relation(fields: [typeId], references: [id])

  // Statut général du dossier - vue synthétique/legacy conservée pour la V1.
  // Les vrais sous-processus vivent progressivement dans leurs propres flux
  // (statutAnahId, statutCeeId, statutTravauxId ci-dessous, puis un futur
  // flux commercial paramétrable avec le moteur de programmes).
  statutId String
  statut   DossierStatus @relation(fields: [statutId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Montants en centimes
  montantDevisTTC Int
  montantAideMPR  Int @default(0)
  montantAideCEE  Int @default(0)

  montantEncaisseClient Int @default(0)
  montantEncaisseMPR    Int @default(0)
  montantEncaisseCEE    Int @default(0)

  modePaiementAideId String?
  modePaiementAide   ModePaiement? @relation(fields: [modePaiementAideId], references: [id])
  marId              String?
  mar                Mar? @relation(fields: [marId], references: [id])
  delegataireCeeId   String?
  delegataireCee     DelegataireCee? @relation(fields: [delegataireCeeId], references: [id])
  dateDepotDelegataireCee DateTime?

  // Suivi administratif ANAH (rénovation d'ampleur uniquement)
  statutAnahId   String?
  statutAnah     StatutAnah? @relation(fields: [statutAnahId], references: [id])
  dateDepotAnah  DateTime?
  dateOctroiAnah DateTime?

  // Flux CEE et flux travaux/chantier - indépendants du statut général et
  // du suivi ANAH, sur le même principe (optionnels, paramétrables).
  statutCeeId      String?
  statutCee        StatutCee? @relation(fields: [statutCeeId], references: [id])
  statutTravauxId  String?
  statutTravaux    StatutTravaux? @relation(fields: [statutTravauxId], references: [id])

  // Programme/workflow paramétrable (optionnel - un dossier créé avant ou
  // sans programme n'en a pas). La version est figée à l'affectation : si
  // le programme évolue ensuite, ce dossier garde SA version et son
  // comportement ne change jamais rétroactivement.
  programmeVersionId String?
  programmeVersion   ProgrammeVersion? @relation(fields: [programmeVersionId], references: [id])

  dateSignatureDevis DateTime?
  dateDebutTravaux   DateTime?
  dateFinTravaux     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postesTravaux        DossierPosteTravaux[]
  documents            DossierDocument[]
  taches               Tache[]
  commandes            Commande[]
  mouvementsFinanciers MouvementFinancier[]
  dossierEtapes        DossierEtape[]

  @@index([statutId])
  @@index([typeId])
  @@index([clientId])
  @@index([organisationId])
  @@index([statutCeeId])
  @@index([statutTravauxId])
  @@index([programmeVersionId])
}

model DossierPosteTravaux {
  id                     String      @id @default(cuid())
  dossierId              String
  dossier                Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type                   TypeTravaux
  surfaceM2              Float?
  quantite               Int? // ex. nombre de splits pour une PAC air/air, nombre de fenêtres...
  montantDevisHTCts      Int? // montant HT de ce geste sur le devis (base éligible aux aides)
  montantDevisTTCCts     Int?
  montantCumac           Int? // en kWh cumac
  montantPrimeCalculeCts Int? // prime CEE calculée, en centimes

  // Qui pose ce poste : sous-traitant OU régie (équipe interne), pas les deux
  sousTraitantId              String?
  sousTraitant                SousTraitant? @relation(fields: [sousTraitantId], references: [id])
  montantPoseSousTraitanceCts Int? // montant confié au sous-traitant, en centimes

  regieId         String?
  regie           Regie? @relation(fields: [regieId], references: [id])
  montantRegieCts Int? // montant de la pose en régie, en centimes

  montantMaterielHTCts  Int? // en centimes
  montantMaterielTTCCts Int? // en centimes

  createdAt DateTime @default(now())

  @@index([dossierId])
}

model SousTraitant {
  id                 String       @id @default(cuid())
  nom                String
  typeTravaux        TypeTravaux?
  tarifM2Cts         Int? // tarif au m2, en centimes
  tarifFixeCts       Int? // tarif fixe, en centimes
  fourniPose         Boolean      @default(false)
  telephone          String?
  email              String?
  delaiPaiementJours Int? // délai de paiement après fin de travaux
  actif              Boolean      @default(true)
  createdAt          DateTime     @default(now())

  commandes     Commande[]
  postesTravaux DossierPosteTravaux[]
}

// Documents et photos attachés à un dossier (devis, audit, photos de visite
// ou de chantier). Fichiers stockés sur disque, servis via une route API
// protégée par authentification.
model DossierDocument {
  id            String       @id @default(cuid())
  dossierId     String
  dossier       Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type          TypeDocument
  nomFichier    String
  cheminFichier String
  mimeType      String
  tailleOctets  Int
  createdAt     DateTime     @default(now())

  @@index([dossierId])
}

model Fournisseur {
  id                 String   @id @default(cuid())
  nom                String
  delaiPaiementJours Int?
  telephone          String?
  email              String?
  createdAt          DateTime @default(now())

  commandes Commande[]
}

model Commande {
  id             String        @id @default(cuid())
  dossierId      String
  dossier        Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fournisseurId  String?
  fournisseur    Fournisseur?  @relation(fields: [fournisseurId], references: [id])
  sousTraitantId String?
  sousTraitant   SousTraitant? @relation(fields: [sousTraitantId], references: [id])

  numeroBL            String?
  montantCts          Int // en centimes
  statut              StatutCommande @default(COMMANDEE)
  dateCommande        DateTime       @default(now())
  dateLivraisonPrevue DateTime?
  dateLivraisonReelle DateTime?

  createdAt DateTime @default(now())

  @@index([dossierId])
  @@index([fournisseurId])
}

model Tache {
  id           String      @id @default(cuid())
  dossierId    String
  dossier      Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type         TypeTache
  titre        String
  description  String?
  dateEcheance DateTime
  statut       StatutTache @default(A_FAIRE)
  assigneAId   String?
  assigneA     User?       @relation(fields: [assigneAId], references: [id])

  // Renseignés uniquement pour les tâches générées automatiquement par le
  // moteur de workflow (src/lib/workflow.ts) - la contrainte unique ci-
  // dessous est la garantie d'idempotence : recalculer plusieurs fois ne
  // crée jamais deux fois la même tâche pour une même étape+modèle.
  dossierEtapeId     String?
  dossierEtape       DossierEtape?     @relation(fields: [dossierEtapeId], references: [id], onDelete: Cascade)
  modeleTacheEtapeId String?
  modeleTacheEtape   ModeleTacheEtape? @relation(fields: [modeleTacheEtapeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dossierEtapeId, modeleTacheEtapeId])
  @@index([dossierId])
  @@index([statut, dateEcheance])
}

// Mouvement financier daté et traçable, unitaire (un encaissement, un
// paiement, une commission...). Coexiste avec les compteurs cumulés déjà
// présents sur Dossier (montantEncaisseClient/MPR/CEE) qui restent la
// source utilisée par l'UI actuelle - ce modèle est la fondation d'un
// futur grand livre détaillé, pas encore branché nulle part par défaut.
model MouvementFinancier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  type      TypeMouvementFinancier
  categorie CategorieMouvementFinancier

  payeur       String? // libellé libre : "Client", "ANAH", "Délégataire CEE X"...
  beneficiaire String?

  montantPrevuCts Int?
  montantReelCts  Int?
  datePrevue      DateTime?
  dateReelle      DateTime?

  statut StatutMouvementFinancier @default(PREVU)
  // Origine libre - utiliser la valeur "SOURCE_EXISTANTE_AGREGEE" pour tout
  // mouvement reconstitué depuis les compteurs agrégés existants (sans date
  // métier réelle connue), afin de ne jamais le confondre avec un mouvement
  // réellement daté et tracé.
  origine     String?
  commentaire String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossierId])
  @@index([organisationId])
  @@index([statut])
}

// Journal d'audit minimal - qui a fait quoi, quand. entityId est une chaîne
// libre (pas de FK) car une même ligne peut référencer n'importe quel type
// d'entité (document, tâche, poste de travaux...) sans imposer une relation
// Prisma par type audité.
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  action     String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([entityType, entityId])
}

// ============================================================
// Moteur de programmes / workflows paramétrables
//
// Programme -> plusieurs ProgrammeVersion -> plusieurs EtapeProgramme
// (la définition du modèle, éditable tant que la version n'est pas
// publiée). Quand une ProgrammeVersion est affectée à un Dossier, ses
// DossierEtape (l'instance réelle pour CE dossier) sont créées et tenues
// à jour par recalculateDossierWorkflow() (src/lib/workflow.ts) - jamais
// à la main, jamais dupliquées. Une version publiée est figée : pour la
// faire évoluer, on la duplique plutôt que de la modifier en place, afin
// que les dossiers déjà engagés ne changent jamais de comportement.
// ============================================================

model Programme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  nom            String
  code           String
  description    String?
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  versions ProgrammeVersion[]

  @@unique([organisationId, code])
  @@index([organisationId])
}

model ProgrammeVersion {
  id             String    @id @default(cuid())
  programmeId    String
  programme      Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  numeroVersion  String
  nomVersion     String?
  dateDebutEffet DateTime?
  dateFinEffet   DateTime?
  actif          Boolean   @default(true)
  // Fige la structure (étapes/dépendances/tâches modèles) dès que true -
  // dupliquer pour modifier. Voir requireVersionModifiable() côté serveur.
  publie         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  etapes   EtapeProgramme[]
  dossiers Dossier[]

  @@unique([programmeId, numeroVersion])
  @@index([programmeId])
}

model EtapeProgramme {
  id                 String           @id @default(cuid())
  programmeVersionId String
  programmeVersion   ProgrammeVersion @relation(fields: [programmeVersionId], references: [id], onDelete: Cascade)
  code               String
  nom                String
  description        String?
  ordre              Int              @default(0)
  typeFlux           TypeFluxEtape    @default(AUTRE)
  delaiNormalJours   Int?
  delaiAlerteJours   Int?
  roleResponsable    Role?
  obligatoire        Boolean          @default(true)
  actif              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  dossierEtapes   DossierEtape[]
  // Étapes dont CETTE étape dépend (doivent être TERMINE avant elle).
  dependances     EtapeDependance[] @relation("Etape")
  // Étapes qui dépendent de CETTE étape.
  dependuesPar    EtapeDependance[] @relation("DependsOn")
  documentsRequis EtapeDocumentRequis[]
  modelesTaches   ModeleTacheEtape[]

  @@unique([programmeVersionId, code])
  @@index([programmeVersionId])
}

model EtapeDependance {
  id               String              @id @default(cuid())
  etapeId          String
  etape            EtapeProgramme      @relation("Etape", fields: [etapeId], references: [id], onDelete: Cascade)
  dependsOnEtapeId String
  dependsOnEtape   EtapeProgramme      @relation("DependsOn", fields: [dependsOnEtapeId], references: [id], onDelete: Cascade)
  type             TypeDependanceEtape @default(ALL_COMPLETED)
  createdAt        DateTime            @default(now())

  @@unique([etapeId, dependsOnEtapeId])
  @@index([etapeId])
  @@index([dependsOnEtapeId])
}

// Déclare qu'une étape nécessite un document d'un type donné pour être
// considérée complète. Intégration additive au système Documents existant
// (TypeDocument, DossierDocument) - pas de refonte : la présence est
// simplement vérifiée en cherchant un DossierDocument du dossier dont le
// type correspond.
model EtapeDocumentRequis {
  id               String         @id @default(cuid())
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id], onDelete: Cascade)
  typeDocument     TypeDocument
  obligatoire      Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([etapeProgrammeId, typeDocument])
  @@index([etapeProgrammeId])
}

// Modèle de tâche générée automatiquement quand une DossierEtape devient
// A_FAIRE. roleResponsable sert de repli si aucun utilisateur précis n'est
// déterminable automatiquement (V1 : pas de moteur de répartition).
model ModeleTacheEtape {
  id               String         @id @default(cuid())
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id], onDelete: Cascade)
  titre            String
  description      String?
  type             TypeTache      @default(AUTRE)
  delaiJours       Int            @default(0)
  roleResponsable  Role?
  obligatoire      Boolean        @default(true)
  actif            Boolean        @default(true)
  createdAt        DateTime       @default(now())

  taches Tache[]

  @@index([etapeProgrammeId])
}

// Instance réelle d'une étape sur un dossier précis (à distinguer de
// EtapeProgramme, qui n'est qu'une définition). Une ligne par
// (dossier, étape) - créée et recalculée uniquement par
// recalculateDossierWorkflow(), jamais par une saisie manuelle directe.
model DossierEtape {
  id               String         @id @default(cuid())
  organisationId   String
  organisation     Organisation   @relation(fields: [organisationId], references: [id])
  dossierId        String
  dossier          Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  etapeProgrammeId String
  etapeProgramme   EtapeProgramme @relation(fields: [etapeProgrammeId], references: [id])

  statut         StatutDossierEtape @default(NON_DISPONIBLE)
  dateDisponible DateTime?
  dateDebut      DateTime?
  dateEcheance   DateTime?
  dateTerminee   DateTime?

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id])

  commentaire   String?
  bloque        Boolean @default(false)
  raisonBlocage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taches Tache[]

  @@unique([dossierId, etapeProgrammeId])
  @@index([organisationId])
  @@index([dossierId])
  @@index([etapeProgrammeId])
  @@index([statut])
}
